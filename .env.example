# Creator wallet only. Base58 secret key. One wallet signs the create transaction.
DEPLOYER_SECRET_KEY=

# Pinata JWT for the image and metadata JSON. Required for a live launch.
PINATA_JWT=

# Optional. Overrides rpc_url in config.json.
RPC_URL=

# Status page bind. Defaults to 127.0.0.1:8790.
# HOST=127.0.0.1
# PORT=8790
